---
import '../styles/global.css';
import { LOCALES, href, t, type Lang } from '../i18n';

export interface Alternate {
  lang: Lang;
  url: string; // chemin avec la base, ex. /blogsdg/en/
}

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Versions de cette page dans les autres langues. Absent = pas de lien de langue. */
  alternates?: Alternate[];
  type?: 'website' | 'article';
  published?: Date;
  tags?: string[];
}

const { lang, title, description, alternates = [], type = 'website', published, tags = [] } = Astro.props;
const ui = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} · ${ui.siteTitle}` : ui.siteTitle;
const desc = description ?? ui.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
const rss = href(lang, undefined, 'rss.xml').replace(/\/$/, '');
const others = alternates.filter((a) => a.lang !== lang);
const current = Astro.url.pathname;
const nav = [
  { label: ui.nav.home, url: href(lang) },
  { label: ui.nav.journey, url: href(lang, 'journey') },
  { label: ui.nav.tags, url: href(lang, 'tags') },
  { label: ui.nav.about, url: href(lang, 'about') },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content="Stefan" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {others.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.url, Astro.site)} />)}
    <link rel="alternate" type="application/rss+xml" title={`${ui.siteTitle} (${lang})`} href={rss} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={ui.siteTitle} />
    <meta property="og:title" content={title ?? ui.siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALES[lang].og} />
    {others.map((a) => <meta property="og:locale:alternate" content={LOCALES[a.lang].og} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:author" content="Stefan" />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#contenu">{ui.skip}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href(lang)}>{ui.siteTitle}</a>
        <nav aria-label={ui.nav.home}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.url} aria-current={current === item.url ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          others.length > 0 && (
            <ul class="langs" aria-label="Langues / Languages">
              {others.map((a) => (
                <li>
                  <a href={a.url} hreflang={a.lang} lang={a.lang}>
                    {LOCALES[a.lang].label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>
    <main id="contenu" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          © {new Date().getFullYear()} Stefan · {ui.footer} · <a href={rss}>{ui.rss}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

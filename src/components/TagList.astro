---
import { href, tagSlug, type Lang } from '../i18n';

interface Props {
  tags: string[];
  lang: Lang;
}

const { tags, lang } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={href(lang, 'tags', tagSlug(tag))}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}
